  "attributes": {
    "brand": "沃集鲜",
    "product_name": [
      {
        "lang": "zh-Hans",
        "text": "蒜香罗勒干白葡萄酒蛤蜊拌面"
      }
    ],
    "declared_category": "方便面制品",
    "net_content_label": "198克(面70g+蒜香干白葡萄酒蛤蜊酱包80g+青酱包8g+蒜香黄油风味面包干10g+扇贝口蘑双鲜料包(罐头制品)30g)",
    "ingredients_text": [
      {
        "lang": "zh-Hans",
        "text": "面配料:硬质颗粒小麦粉(100%)；蒜香干白葡萄酒蛤蜊酱包配料:水、大蒜(≥18%)、玉米油(≥15%)、干白葡萄酒(≥9%)、蛤蜊(≥2%)、酿造酱油、鸡骨原汤(复合调味料)、冰糖、食用马铃薯淀粉、海鲜调味粉、辣椒、橄榄油、海带调味液、葡萄浓缩汁、酵母抽提物、昆布粉、味精、食用盐、香辛料；青酱包配料:罗勒(≥35%)、特级初榨橄榄油(≥30%)、葵花籽油、松籽仁、干酪、食用盐、大蒜、小青柠汁、非活性食用酵母粉、乳酸链球菌素(≤0.02%)；扇贝口蘑双鲜料包(罐头制品)配料:扇贝肉(≥50%)、白蘑菇(≥25%)、非转基因大豆油、大蒜、蒜香调味料(复合调味料)、食用盐、白砂糖、味精；蒜香黄油风味面包干配料:面包用小麦粉(小麦、维生素C、木聚糖酶、葡萄糖氧化酶、磷酸三钙、硬脂酰乳酸钙、α-淀粉酶)、水、人造黄油(≥24%)、大蒜(≥2%)、白砂糖、欧芹叶、高活性干酵母(经灭活)、食用盐"
      }
    ],
    "allergens_raw_text": "致敏物质:含有含麸质的谷物、大豆、甲壳纲类动物、坚果和乳成分",
