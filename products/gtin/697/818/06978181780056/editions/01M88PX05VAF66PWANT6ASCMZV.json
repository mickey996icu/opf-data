  "attributes": {
    "brand": "艾泽拉斯",
    "product_name": [
      {
        "lang": "zh-Hans",
        "text": "香辣桂林风味米粉"
      }
    ],
    "net_content_label": "165克",
    "ingredients_text": [
      {
        "lang": "zh-Hans",
        "text": "调制干米粉包:大米、玉米淀粉、水。卤汁包:水、食用盐、酱油(含焦糖色)、蚝油、食用植物油、牛肉、猪骨、冰糖、味精、香辛料、5'-呈味核苷酸二钠、山梨酸钾、乳酸链球菌素。酸豆角酸笋包:酸豆角(豆角、水、食用盐、苯甲酸钠、山梨酸钾)、酸笋(竹笋、水、食用盐、焦亚硫酸钠、苯甲酸钠)、食用植物油、辣椒、柠檬酸。雪豆包:豌豆、食用植物油、食用盐、白砂糖、洋葱粉。辣椒油包:食用植物油、食用猪油、香葱、辣椒、香辛料。脱水葱包:小米葱。"
      }
    ],
    "allergens_raw_text": "含有大豆、含有麸质的谷物(小麦)。生产线同时加工花生、蛋类、坚果类制品。",
    "origin": {
      "country": "CN",
      "region": "广西桂林市",
      "raw_text": "广西桂林市"
    },
    "parties": [
      {
        "role": "manufacturer",
        "name": "桂林艾泽拉斯食品有限公司",
        "address": "灵川县灵川镇粑粑厂村委独田村(地号:96)",
        "license": "SC10345032301693"
